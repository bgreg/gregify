#!/bin/zsh
set -e

branch=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0

if [[ "$branch" == "main" || "$branch" == "master" ]]; then
  exit 0
fi

(
  sleep 2

  actions=()

  if command -v gh &>/dev/null && gh repo view &>/dev/null 2>&1; then
    pr_number=$(gh pr list --head "$branch" --state open --json number --jq '.[0].number' 2>/dev/null)

    if [[ -n "$pr_number" && "$pr_number" != "null" ]]; then
      is_draft=$(gh pr view "$pr_number" --json isDraft --jq '.isDraft' 2>/dev/null)
      if [[ "$is_draft" != "true" ]]; then
        gh pr ready "$pr_number" --undo 2>/dev/null && actions+=("draft")
      fi
      gh pr edit "$pr_number" --add-label "wip" 2>/dev/null && actions+=("wip")
    fi
  fi

  if command -v jira &>/dev/null; then
    ticket=$(grep -oE 'SD-[0-9]+' <<< "$branch")
    if [[ -n "$ticket" ]]; then
      jira issue move "$ticket" "In Progress" 2>/dev/null && actions+=("jira:in-progress")
    fi
  fi

  if [[ ${#actions[@]} -gt 0 ]]; then
    printf "pre-push: %s\n" "${actions[*]}" >&2
  fi
) &

exit 0
