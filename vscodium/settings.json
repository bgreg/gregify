{
  "window.commandCenter": true,
  "files.autoSave": "onFocusChange",
  "editor.formatOnSave": true,
  "[ruby]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "Shopify.ruby-lsp",
  },
  "[shellscript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "foxundermoon.shell-format",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
  },
  "[lua]": {
    "editor.defaultFormatter": "sumneko.lua",
  },
  "shellformat.flag": "-i 2 -bn -ci -sr",
  "bashIde.shellcheckPath": "",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "files.trimTrailingWhitespace": true,
  "editor.cursorSurroundingLines": 8,
  "editor.cursorSurroundingLinesStyle": "all",
  "editor.rulers": [120],
  "editor.wordWrap": "off",
  "editor.wordWrapColumn": 120,
  "editor.wrappingIndent": "same",
  "editor.guides.indentation": false,
  "editor.cursorBlinking": "solid",
  "editor.hover.delay": 250,
  "terminal.integrated.cursorBlinking": false,
  "search.smartCase": true,
  "workbench.editor.openSideBySideDirection": "right",
  "Lua.runtime.version": "LuaJIT",
  "Lua.diagnostics.globals": ["vim"],
  "Lua.workspace.checkThirdParty": false,
  "Lua.telemetry.enable": false,
  "Lua.workspace.library": ["/opt/homebrew/share/nvim/runtime/lua"],
  "testing.defaultGutterClickAction": "contextMenu",
  "testing.automaticallyOpenTestResults": "openExplorerOnTestStart",
  "githubPullRequests.pullBranch": "never",
  "git.openRepositoryInParentFolders": "always",
  "workbench.tree.enableStickyScroll": false,
  "git.confirmSync": false,
  "remote.autoForwardPortsSource": "hybrid",
  "rubyLsp.erbSupport": true,
  "terminal.integrated.profiles.osx": {
    "zsh": {
      "path": "/bin/zsh",
      "args": ["-l", "-i"],
    },
  },
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.inheritEnv": true,
  "terminal.integrated.env.osx": {
    "DATABASE_URL": "postgresql://gregmcguirk@localhost/api_service_test",
    "MEILISEARCH_URL": "http://localhost:7700",
    "MEILISEARCH_API_KEY": "masterKey",
  },
  "rubyLsp.enabledFeatures": {
    "codeLens": true,
    "documentHighlights": true,
    "documentLink": true,
    "documentSymbols": true,
    "foldingRanges": true,
    "formatting": true,
    "hover": true,
    "inlayHint": true,
    "onTypeFormatting": true,
    "selectionRanges": true,
    "semanticHighlighting": true,
    "completion": true,
    "codeActions": true,
    "diagnostics": true,
    "goToDefinition": true,
    "goToDeclaration": true,
    "goToImplementation": true,
    "goToTypeDefinition": true,
    "signatureHelp": true,
    "workspaceSymbol": true,
  },
  "rubyLsp.formatter": "rubocop",
  "rubyLsp.addonSettings": {
    "Ruby LSP RSpec": {
      "rspecCommand": "DATABASE_URL=postgresql://gregmcguirk@localhost/api_service_test MEILISEARCH_URL=http://localhost:7700 MEILISEARCH_API_KEY=masterKey bundle exec rspec",
    },
  },
  "editor.codeLens": true,
  "files.exclude": {
    "**/node_modules": true,
    "**/log": true,
    "**/tmp": true,
    "**/coverage": true,
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/log": true,
    "**/tmp": true,
    "**/coverage": true,
  },
  "testing.automaticallyOpenPeekView": "failureInVisibleDocument",
  "testing.followRunningTest": false,
  "vscode-neovim.neovimExecutablePaths.darwin": "/opt/homebrew/bin/nvim",
  "keyboard.dispatch": "keyCode",
  "diffEditor.ignoreTrimWhitespace": false,
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": true,
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "workbench.editor.enablePreviewFromCodeNavigation": true,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 5,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.editor.revealIfOpen": true,
  "workbench.editor.closeOnFileDelete": true,
  "git.autorefresh": true,
  "claudeCode.allowDangerouslySkipPermissions": true,
  "claudeCode.initialPermissionMode": "plan",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
  },
  "editor.minimap.enabled": false,
  "claudeCode.preferredLocation": "panel",
  "editor.bracketPairColorization.enabled": false,
  "editor.autoClosingBrackets": "never",
  "editor.guides.bracketPairsHorizontal": false,
  "editor.guides.highlightActiveBracketPair": false,
  "claudeCode.useTerminal": false,
  "git.ignoreRebaseWarning": true,
  "window.title": "${rootName} [${activeFolderShort}] ${dirty}${activeEditorShort}",
  "window.titleSeparator": "${activeEditorShort}${separator}${rootName}${separator}${profileName}",
  "window.customTitleBarVisibility": "windowed",
  "diffEditor.experimental.showMoves": true,
  "chat.agent.maxRequests": 10000,
  "explorer.openEditors.sortOrder": "alphabetical",
  "editor.codeActionsOnSave": {
    "source.fixAll.markdownlint": "explicit",
  },
  "markdownlint.config": {
    "MD013": { "line_length": 120 },
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.quickSuggestions": {
      "other": false,
      "comments": false,
      "strings": false,
    },
    "editor.suggestOnTriggerCharacters": false,
    "editor.wordBasedSuggestions": "off",
    "editor.inlineSuggest.enabled": false,
    "editor.parameterHints.enabled": false,
    "editor.acceptSuggestionOnEnter": "off",
  },
  "chat.tools.urls.autoApprove": {
    "https://docs.anthropic.com": {
      "approveRequest": true,
      "approveResponse": false,
    },
  },
  "hediet.vscode-drawio.resizeImages": null,
  "hediet.vscode-drawio.theme": "kennedy",
  "hediet.vscode-drawio.appearance": "light",
  "markdown-preview-enhanced.previewTheme": "github-dark.css",
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  "workbench.colorTheme": "Spinel",
  "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",
  "chat.fontFamily": "source code pro",
  "editor.fontFamily": "Source Code Pro",
  "editor.fontSize": 14,
  "accessibility.signals.chatResponseReceived": {
    "sound": "off",
  },
  "chat.editor.fontFamily": "Source Code Pro",
  "chat.editor.fontSize": 14,
  "chat.editor.wordWrap": "on",
  "chat.fontSize": 14,
  "chat.agentsControl.enabled": "badge",
  "chat.editing.explainChanges.enabled": true,
  "chat.editor.claude.preferAgentHost": true,
  "chat.hookFilesLocations": {
    "~/.copilot/hooks": false,
    "~/.claude/settings.json": false,
  },
  "chat.restoreLastPanelSession": true,
  "chat.viewProgressBadge.enabled": true,
  "claudeCode.hideOnboarding": true,
}
